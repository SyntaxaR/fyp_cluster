# FYP Cluster Worker — systemd unit file
#
# Install on each worker Pi:
#     sudo cp scripts/fyp-worker.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable fyp-worker
#     sudo systemctl start  fyp-worker
#
# Tail logs:
#     journalctl -u fyp-worker -f
#
# The worker bootstraps via DHCP from the controller's dnsmasq, so make sure
# the controller is up first (or just let the worker retry until it sees one).
[Unit]
Description=FYP Cluster Worker
Documentation=https://github.com/SyntaxaR/fyp_cluster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

WorkingDirectory=/home/pi/fyp_cluster/latest
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/pi/.local/bin
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/pi/fyp_cluster/latest/worker.sh
ExecStop=/bin/kill -SIGTERM $MAINPID

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
